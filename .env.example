# ============================================
# Variables de entorno — copiar a .env
# ============================================

DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=

HOST=0.0.0.0
PORT=3000
# IP que se muestra como enlace LAN (opcional; si vacío, se detecta automáticamente)
LAN_IP=

# Autenticación por roles (AUTH_ENABLED=false desactiva login en desarrollo)
AUTH_ENABLED=true
AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# Formato: usuario:contraseña:rol;usuario:contraseña:rol
# Roles: administracion | direccion | gerencia_comercial | contabilidad
AUTH_USERS=admin:Admin2026!:administracion;direccion:Direccion2026!:direccion;gerencia:Comercial2026!:gerencia_comercial;contabilidad:Conta2026!:contabilidad

NETWORK_USER=
NETWORK_PASSWORD=
APP_USER=
APP_PASSWORD=
EMAIL_USER=
EMAIL_PASSWORD=
API_KEY=
API_SECRET=

# OpenAI — Asistente IA
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
