# PostgreSQL (Render, Railway, Supabase, Neon, etc.)
DATABASE_URL=postgresql://usuario:password@host:5432/balderrama_cloud

HOST=0.0.0.0
PORT=4000

# Clave que usa el backend local en header X-API-Key
CLOUD_SYNC_API_KEY=cambiar-por-clave-segura-larga

# Opcional: solo aceptar payloads de este origen
# CLOUD_SYNC_ALLOWED_SOURCE=local-dashboard

# Acceso de la app móvil. No reutilizar CLOUD_SYNC_API_KEY dentro de la app.
# Formato: usuario:contraseña:rol;usuario:contraseña:rol
MOBILE_AUTH_USERS=usuario:cambiar-contraseña:direccion
MOBILE_AUTH_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# Orígenes web adicionales, separados por coma (Capacitor y localhost ya están incluidos)
# MOBILE_ALLOWED_ORIGINS=https://app.ejemplo.com
